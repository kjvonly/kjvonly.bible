# Host address nginx proxies to.
# Set this to the Docker host's LAN/IP address reachable from the nginx container.
HOST_IP=192.168.1.100

# Public hostname handled by nginx.
SERVER_NAME=kjvonly.home

# Certificate/key basename under ./certs.
# nginx expects:
#   ./certs/${CERT_NAME}.crt
#   ./certs/${CERT_NAME}.key
CERT_NAME=kjvonly.home

# Host ports published by the production application stack.
WEB_PORT=8080
RELAY_PORT=3334
BLOSSOM_PORT=3335
